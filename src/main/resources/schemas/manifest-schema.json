{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web app manifest",
  "type": "object",
  "required": ["name", "short_name", "start_url", "display", "icons"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "short_name": { "type": "string", "minLength": 1 },
    "start_url": { "type": "string" },
    "display": { "type": "string" },
    "scope": { "type": "string" },
    "theme_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "background_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["src", "sizes", "type"],
        "properties": {
          "src": { "type": "string", "pattern": "^/" },
          "sizes": { "type": "string", "pattern": "^\\d+x\\d+$" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
